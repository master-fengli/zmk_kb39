#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
};

/ {
    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "QWRT";
            bindings = <
&kp Q           &kp W         &kp E    &kp R             &kp T                                  &kp Y        &kp U        &kp I      &kp O              &kp P
&mt LEFT_ALT A  &mt LSHIFT S  &lt 3 D  &mt LCTRL F       &lt 5 G                                &lt 5 H      &mt RCTRL J  &lt 4 K    &mt RIGHT_SHIFT L  &mt RIGHT_ALT SEMI
&kp Z           &kp X         &kp C    &kp V             &kp B                                  &kp N        &kp M        &kp COMMA  &kp PERIOD         &kp SLASH
&none           &none         &none    &mt LEFT_GUI TAB  &lt 1 SPACE  &mkp LCLK  &kp BACKSPACE  &lt 2 ENTER                                             &mkp LCLK
            >;
        };

        LH {
            label = "LH";
            bindings = <
&kp PRINTSCREEN  &kp CAPS  &trans     &trans  &trans                   &none      &none             &kp PLUS   &kp BACKSLASH      &kp PIPE
&trans           &trans    &mkp RCLK  &trans  &trans                   &kp GRAVE  &kp SINGLE_QUOTE  &mkp LCLK  &kp DOUBLE_QUOTES  &kp COLON
&trans           &trans    &trans     &trans  &trans                   &kp TILDE  &kp K_BACK        &kp MINUS  &kp K_FORWARD      &kp QUESTION
&trans           &trans    &trans     &trans  &trans  &trans  &kp INS  &kp ESC                                                    &trans
            >;
        };

        RH {
            label = "RH";
            bindings = <
&kp K_MUTE  &kp F20            &kp C_BRI_UP  &trans           &trans                  &kp C_VOL_UP  &kp C_VOLUME_DOWN  &kp UP    &kp PAGE_UP  &kp PAGE_DOWN
&trans      &kp C_VOLUME_DOWN  &kp C_BRI_DN  &kp C_VOLUME_UP  &trans                  &kp HOME      &kp LEFT           &kp DOWN  &kp RIGHT    &kp END
&trans      &trans             &trans        &trans           &trans                  &trans        &trans             &trans    &trans       &trans
&trans      &trans             &trans        &trans           &trans  &trans  &trans  &trans                                                  &trans
            >;
        };

        SYM {
            label = "SYM";
            bindings = <
&trans  &trans  &trans  &trans  &trans                  &kp EXCLAMATION   &kp AT_SIGN        &kp HASH        &kp DOLLAR            &kp PERCENT
&trans  &trans  &trans  &trans  &trans                  &kp CARET         &kp AMPERSAND      &kp ASTERISK    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&trans  &trans  &trans  &trans  &trans                  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp UNDERSCORE  &kp LEFT_BRACE        &kp RIGHT_BRACE
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                                                                     &trans
            >;
        };

        NUM {
            bindings = <
&kp N1  &kp N2         &kp N3     &kp N4            &kp N5                  &trans  &trans  &trans  &trans  &trans
&kp N6  &kp N7         &kp N8     &kp N9            &kp N0                  &trans  &trans  &trans  &trans  &trans
&trans  &kp LESS_THAN  &kp EQUAL  &kp GREATER_THAN  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans         &trans     &trans            &trans  &trans  &trans  &trans                          &trans
            >;

            label = "NUM";
        };

        SNIPE {
            label = "SNIPE";
            bindings = <
&kp F1       &kp F2      &kp F3      &kp F4  &kp F5                   &none    &none   &none      &none   &none
&kp F6       &kp F7      &kp F8      &kp F9  &kp F10                  &kp DEL  &trans  &mkp LCLK  &trans  &trans
&kp F11      &kp F12     &none       &none   &none                    &none    &none   &none      &none   &none
&bootloader  &bt BT_NXT  &bt BT_CLR  &trans  &trans   &trans  &trans  &trans                              &bootloader
            >;
        };
    };
};
